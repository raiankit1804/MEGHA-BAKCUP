# WeatherGPT v2.0 — environment template
# Copy to .env and fill in your values

# ────────────────── REQUIRED ──────────────────────────────────────────────────
# Get from: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# ────────────────── DATABASES (default = Docker Compose values) ───────────────
POSTGRES_URL=postgresql+asyncpg://weathergpt:weathergpt@localhost:5432/weathergpt
MONGODB_URL=mongodb://localhost:27017
REDIS_URL=redis://localhost:6379

# ────────────────── GOOGLE OAUTH (optional) ───────────────────────────────────
# If not set → guest-only mode, Google auth button shows 503
# Get from: https://console.cloud.google.com/ → APIs & Services → Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/callback

# ────────────────── JWT ───────────────────────────────────────────────────────
# Must be at least 32 random characters in production
JWT_SECRET=changeme-in-production-please-32chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_HOURS=72

# ────────────────── BHASHINI (optional) ──────────────────────────────────────
# If not set → Gemini NMT for translation, gTTS for voice
# Get from: https://bhashini.gov.in/ulca/model-explore
BHASHINI_USER_ID=your_bhashini_user_id_here
BHASHINI_API_KEY=your_bhashini_api_key_here

# ────────────────── APP ───────────────────────────────────────────────────────
ENVIRONMENT=development
VITE_API_BASE_URL=http://localhost:8000
